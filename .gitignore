# .gitignore
# ignore files and folders
.vscode/
node_modules/
*.pyc
*.log
*.tmp
*.swp
*.o
*.class
*.cache
*.env
*.env.local

# ignore IDE specific files
.idea/
.c9/
.eclipse/
.vs/
.pycharm/
.sublime-text/

# ignore project specific files
dist/
build/
coverage/
__pycache__/
*.egg-info/
*.dist-info/
*.whl
*.spec
*.exe
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.Z
*.tar.lzma
*.tar.lz
*.tar
*.tgz
*.tbz2
